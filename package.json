    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.10",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
