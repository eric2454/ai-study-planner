    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.468.0",
    "next": "^16.0.10",
    "next-auth": "4.24.15",
    "nodemailer": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
